[Desktop Entry]
Type=Application
Version=1.0
Name=Send with T2 Share
Comment=Send files to an Android phone with Quick Share
Exec=/usr/local/bin/t2-share %F
TryExec=/usr/local/bin/t2-share
Icon=org.t2share.gtk
Terminal=false
NoDisplay=true
MimeType=application/octet-stream;
Categories=Network;FileTransfer;
